# fake: FakeEmbeddings + FakeLLM, zero API spend. real: requires both keys below.
PROVIDERS=fake

# Postgres + pgvector (the `db` service in docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeqa

# Required only when PROVIDERS=real
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=

# Optional: raises the GitHub search rate limit
GITHUB_TOKEN=

# Where clones and other runtime artefacts are written
DATA_DIR=./data

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
